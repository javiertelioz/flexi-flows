{
  "name": "DataProcessingPipeline",
  "description": "Complete data processing pipeline with extraction, validation, transformation, enrichment, filtering, aggregation and storage",
  "version": "1.0.0",
  "start_node": "extractData",
  "settings": {
    "max_retries": 3,
    "timeout": "60s",
    "enable_debug": true
  },
  "variables": {
    "batch_size": 10,
    "validation_threshold": 0.8,
    "min_user_score": 3.0
  },
  "nodes": [
    {
      "id": "extractData",
      "type": "task",
      "name": "Extract Data",
      "description": "Extract data from various sources (API, mock, database)",
      "function": "extractData",
      "next": ["validateData"]
    },
    {
      "id": "validateData",
      "type": "task",
      "name": "Validate Data",
      "description": "Validate extracted data for completeness and correctness",
      "function": "validateData",
      "next": ["transformData"]
    },
    {
      "id": "transformData",
      "type": "task",
      "name": "Transform Data",
      "description": "Transform and normalize data fields",
      "function": "transformData",
      "next": ["enrichData"]
    },
    {
      "id": "enrichData",
      "type": "task",
      "name": "Enrich Data",
      "description": "Enrich data with additional information",
      "function": "enrichData",
      "next": ["filterData"]
    },
    {
      "id": "filterData",
      "type": "task",
      "name": "Filter Data",
      "description": "Filter data based on business rules",
      "function": "filterData",
      "next": ["aggregateData"]
    },
    {
      "id": "aggregateData",
      "type": "task",
      "name": "Aggregate Data",
      "description": "Aggregate and summarize processed data",
      "function": "aggregateData",
      "next": ["saveData"]
    },
    {
      "id": "saveData",
      "type": "task",
      "name": "Save Data",
      "description": "Save processed data to storage",
      "function": "saveData"
    }
  ]
}

